rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Admin verified via Firebase Custom Claims OR settings/admin allowlist
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/settings/admin) &&
         request.auth.token.email in get(/databases/$(database)/documents/settings/admin).data.emails) ||
        (exists(/databases/$(database)/documents/settings/admin) &&
         request.auth.token.email == get(/databases/$(database)/documents/settings/admin).data.email)
      );
    }

    // Default: Deny all access to any unlisted collection
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // 1. ADMIN CONFIGURATION
    // ----------------------------------------------------
    match /settings/admin {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // ----------------------------------------------------
    // 2. ACTIVE CONTENT: QUESTION OF THE DAY & WORD OF THE DAY
    // ----------------------------------------------------
    match /qotd/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wordOfDay/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // 3. QUIZ & LEADERBOARD
    // ----------------------------------------------------
    match /quizQuestions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizScores/{doc} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /sectionScores/{doc} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // 4. USER AUTHENTICATION, PROFILES & GAME PROGRESS
    // ----------------------------------------------------
    match /users/{uid} {
      // Read allowed for leaderboard rankings and profiles
      allow read: if true;
      // Users can only write their own profile and cannot escalate privileges
      allow create, update: if isOwner(uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'role']));
      allow delete: if isAdmin();
    }

    match /desktop_sync/{code} {
      allow read, write: if isAuthenticated();
    }

    match /japaCommunity/{deityId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /ramakoti/{doc} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // 5. SERVER-CONTROLLED COLLECTIONS (Subscriptions & Moderation)
    // ----------------------------------------------------
    match /subscribers/{uid} {
      // Users can only inspect their own subscription status
      allow read: if isOwner(uid) || isAdmin();
      // Client-side writes are strictly forbidden (managed by Razorpay Cloud Functions)
      allow write: if isAdmin();
    }

    match /ai_moderation_records/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
