rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // 1. SRI RAMAKOTI (Live 1-Crore Countdown & Real-Time Leaderboard)
    // ====================================================
    match /ramakoti/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ramakoti_leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ====================================================
    // 2. USER AUTHENTICATION, PROFILES, STREAKS & LEADERBOARDS
    // ====================================================
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /desktop_sync/{code} {
      allow read, write: if true;
    }

    match /subscribers/{uid} {
      allow read, write: if request.auth != null;
    }

    // ====================================================
    // 3. DAILY DEVOTIONAL: QUESTION OF THE DAY & WORD OF THE DAY
    // ====================================================
    match /qotd/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /wordOfDay/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ====================================================
    // 4. QUIZ (PRASHNAVALI) CATEGORIES, QUESTIONS & LEADERBOARD SCORES
    // ====================================================
    match /quizQuestions/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizGeneral/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizHari/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizHara/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizDevi/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizTelugu/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizScores/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sectionScores/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ====================================================
    // 5. CHANT COUNTER (JAPA COMMUNITY TALLY & TOTAL MANTRA DIGITS)
    // ====================================================
    match /japaCommunity/{deityId} {
      allow read, write: if true;
    }

    // ====================================================
    // 6. SITE SETTINGS, EVENTS, ITIHASALU & COMMUNITY
    // ====================================================
    match /events/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ithihasaluCategories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ithihasaluSubCategories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ithihasaluShlokas/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /slokas/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /about/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /aboutSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /socialLinks/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /homeCards/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sponsors/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
