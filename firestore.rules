rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // 1. PUBLIC DEVOTIONAL CONTENT (Read: Public, Write: Admin/Auth)
    // ====================================================
    match /events/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /festivals/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /temples/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /templeCategories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /storyCategories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /storyParts/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /libraryCategories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /librarySubcategories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /libraryContent/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ithihasaluCategories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ithihasaluSubCategories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ithihasaluShlokas/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /slokas/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /poojaGods/{godId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /rituals/{ritualId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /about/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /aboutSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /socialLinks/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /homeCards/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sponsors/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /qotd/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /wordOfDay/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ====================================================
    // 2. QUIZ & COMMUNITY SECTION
    // ====================================================
    match /quizQuestions/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizScores/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sectionScores/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /japaCommunity/{deityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ====================================================
    // 3. SRI RAMAKOTI (Live Real-Time 1 Crore Countdown & Leaderboard)
    // ====================================================
    match /ramakoti/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ramakoti_leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ====================================================
    // 4. AUDIO / STREAMING (Legacy Video Section Removed)
    // ====================================================
    match /streamVideos/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /streamCategories/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /streamSettings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ====================================================
    // 5. USER ACCOUNTS & CROSS-DEVICE DESKTOP SYNC
    // ====================================================
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /desktop_sync/{code} {
      allow read, write: if true;
    }

    match /subscribers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
